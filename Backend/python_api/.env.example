# ============================================================
# Thesa Python API — Environment Variables
# Salin file ini menjadi .env dan isi nilainya
# ============================================================

# --- Server ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# --- Redis ---
# Untuk development lokal, gunakan redis://localhost:6379/0
# Untuk Docker, gunakan redis://thesa-redis:6379/0
REDIS_URL=redis://thesa-redis:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://thesa-redis:6379/0
CELERY_RESULT_BACKEND=redis://thesa-redis:6379/1

# --- NeoMakalah AI Engine ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# --- PDF Export ---
CLOUDMERSIVE_API_KEY=your_cloudmersive_api_key_here

# --- Job TTL ---
JOB_TTL_SECONDS=3600

# --- Output ---
OUTPUT_DIR=output
