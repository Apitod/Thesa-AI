# ============================================================
# NeoMakalah Web — Environment Variables (.env.local)
# ============================================================

# URL FastAPI Python API backend
# Development: ganti ke http://localhost:8000 jika tidak pakai Docker
# Production:  ganti ke URL deployment FastAPI
PYTHON_API_URL=http://localhost:8000

# (Opsional) Python executable — tidak lagi dipakai setelah migrasi ke FastAPI
# PYTHON_EXECUTABLE=python3
